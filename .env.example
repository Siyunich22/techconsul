# Скопируйте в .env: cp .env.example .env  (make up делает это автоматически, если .env нет)

APP_ENV=dev

# PostgreSQL
POSTGRES_USER=techocenka
POSTGRES_PASSWORD=techocenka
POSTGRES_DB=techocenka
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3)
MINIO_ROOT_USER=techocenka
MINIO_ROOT_PASSWORD=techocenka-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=techocenka

# Порты сервисов
API_PORT=8000
WEB_PORT=3000

# Безопасность — ОБЯЗАТЕЛЬНО сменить вне dev
JWT_SECRET=change-me
COOKIE_SECURE=false

# Ссылки в письмах (сброс пароля, приглашения)
PUBLIC_URL=http://localhost:3000

# Почта: в dev — Mailpit (UI http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Anthropic API (тексты документов отправляются в Anthropic — см. TZ.md §9)
ANTHROPIC_API_KEY=
LLM_MODEL_ANALYSIS=claude-opus-5-5
LLM_MODEL_EXTRACT=claude-sonnet-5-5
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001

# Celery
WORKER_CONCURRENCY=4

# Тесты
RUN_LIVE_LLM=0
